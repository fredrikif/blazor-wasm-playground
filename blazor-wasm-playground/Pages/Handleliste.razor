@page "/handleliste"
@inject blazor_wasm_playground.Services.AuthService AuthService
@inject blazor_wasm_playground.Services.FirebaseService FirebaseService
@inject NavigationManager Navigation

<PageTitle>Handleliste</PageTitle>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<AuthorizeView>
    <Authorized>
        <div class="card handleliste-card shadow-sm mb-4">
            <div class="card-body">
                <div
                    class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
                    <div>
                        <h1 class="h3 mb-1">Handlelappen Blazor WASM</h1>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="SignOut">Sign out</button>
                </div>

                <form class="row g-3 align-items-end mb-4" @onsubmit="AddItem" @onsubmit:preventDefault>
                    <div class="col-md-7">
                        <label class="form-label visually-hidden" for="itemName">Name</label>
                        <input id="itemName" class="form-control form-control-lg" @bind="newItemName"
                               placeholder="New item name" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center">
                            <img src="@($"{Navigation.BaseUri}img/add.svg")" alt="Add" width="18" height="18"
                                 class="me-2" />
                            Add item
                        </button>
                    </div>
                </form>

                @if (items == null)
                {
                    <p class="mt-4"><em>Loading items...</em></p>
                }
                else if (!items.Any())
                {
                    <p class="mt-4">No items found in <strong>handleliste</strong>.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-borderless table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fw-semibold">@item.Name</span>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <button
                                                    class="btn btn-icon @(item.Pinned ? "btn-icon-active" : "btn-icon-secondary")"
                                                    @onclick="() => TogglePinned(item)" onpointerup="this.blur()"
                                                    title="@(item.Pinned ? "Unpin" : "Pin")">
                                                    <img src="@($"{Navigation.BaseUri}img/{(item.Pinned ? "keep_off" : "keep")}.svg")"
                                                         alt="@(item.Pinned ? "Unpin" : "Pin")" width="18" height="18" />
                                                </button>
                                                <button class="btn btn-icon btn-icon-danger" @onclick="() => DeleteItem(item)"
                                                        title="Delete" onpointerup="this.blur()">
                                                    <img src="@($"{Navigation.BaseUri}img/delete.svg")" alt="Delete" width="18"
                                                         height="18" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            You are not authorized. Please <a href="login">sign in</a> to access the handleliste.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<blazor_wasm_playground.Models.HandlelisteItem>? items;
    private string? errorMessage;
    private string newItemName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await InitializeFirebaseAsync();
    }

    private async Task InitializeFirebaseAsync()
    {
        errorMessage = null;

        try
        {
            await AuthService.InitializeAsync();

            if (AuthService.IsSignedIn)
            {
                await LoadItemsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }


    private async Task SignOut()
    {
        errorMessage = null;

        try
        {
            await AuthService.SignOutAsync();
            items = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadItemsAsync()
    {
        errorMessage = null;

        try
        {
            items = await FirebaseService.GetHandlelisteAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            items = new List<blazor_wasm_playground.Models.HandlelisteItem>();
        }
    }

    private async Task AddItem()
    {
        if (string.IsNullOrWhiteSpace(newItemName))
        {
            errorMessage = "Item name is required.";
            return;
        }

        errorMessage = null;

        try
        {
            var request = new blazor_wasm_playground.Services.HandlelisteItemCreateRequest
            {
                Name = newItemName,
                Pinned = false
            };

            await FirebaseService.AddHandlelisteItemAsync(request);
            newItemName = string.Empty;
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task TogglePinned(blazor_wasm_playground.Models.HandlelisteItem item)
    {
        if (item?.Id == null)
        {
            return;
        }

        errorMessage = null;

        try
        {
            await FirebaseService.UpdateHandlelisteItemPinnedAsync(item.Id, !item.Pinned);
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteItem(blazor_wasm_playground.Models.HandlelisteItem item)
    {
        if (item?.Id == null)
        {
            return;
        }

        errorMessage = null;

        try
        {
            await FirebaseService.DeleteHandlelisteItemAsync(item.Id);
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
