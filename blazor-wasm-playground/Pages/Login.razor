@page "/login"
@inject blazor_wasm_playground.Services.AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<h1>Login</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (AuthService.CurrentUser != null)
{
    <div class="alert alert-success">
        Signed in as <strong>@AuthService.CurrentUser.Email</strong>.
    </div>
    <button class="btn btn-secondary" @onclick="SignOut">Sign out</button>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input id="email" class="form-control" @bind="loginEmail" placeholder="name@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input id="password" type="password" class="form-control" @bind="loginPassword" placeholder="Password" />
            </div>
            <button class="btn btn-primary me-2" @onclick="SignIn">Sign in</button>
            <button class="btn btn-outline-secondary" @onclick="Register">Register</button>
        </div>
    </div>
}

@code {
    private string? errorMessage;
    private string loginEmail = string.Empty;
    private string loginPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthService.InitializeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SignIn()
    {
        errorMessage = null;
        try
        {
            await AuthService.SignInAsync(loginEmail, loginPassword);
            loginPassword = string.Empty;
            Navigation.NavigateTo("/handleliste");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task Register()
    {
        errorMessage = null;
        try
        {
            await AuthService.RegisterAsync(loginEmail, loginPassword);
            loginPassword = string.Empty;
            Navigation.NavigateTo("/handleliste");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SignOut()
    {
        errorMessage = null;
        try
        {
            await AuthService.SignOutAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
