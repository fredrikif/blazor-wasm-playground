@inherits LayoutComponentBase
@inject blazor_wasm_playground.Services.AuthService AuthService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            @if (AuthService.IsSignedIn)
            {
                <div class="text-muted">
                    Signed in as <strong>@GetDisplayName(AuthService.CurrentUser?.Email)</strong>
                </div>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private static string GetDisplayName(string? email)
    {
        return email switch
        {
            "mariets@me.com" => "Marie",
            "fiforsa@gmail.com" => "Fredrik",
            _ => email ?? "Unknown user"
        };
    }
}
