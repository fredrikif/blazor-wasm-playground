@inherits LayoutComponentBase
@inject blazor_wasm_playground.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar @(mobileNavOpen ? "mobile-open" : "")">
        <NavMenu OnLinkClicked="CloseMobileNav" />
    </div>

    @if (mobileNavOpen)
    {
        <div class="mobile-nav-overlay" @onclick="CloseMobileNav" aria-hidden="true"></div>
    }

    <main>
        <header class="site-topbar">
            <button class="nav-toggle mobile-menu" title="Open menu" @onclick="ToggleMobileNav">
                <svg xmlns="http://www.w3.org/2000/svg" height="20" width="20" viewBox="0 0 24 24" fill="currentColor"
                     aria-hidden="true" focusable="false">
                    <rect x="3" y="6" width="18" height="2" rx="1" />
                    <rect x="3" y="11" width="18" height="2" rx="1" />
                    <rect x="3" y="16" width="18" height="2" rx="1" />
                </svg>
            </button>
            <div class="site-user">
                @if (AuthService.IsSignedIn)
                {
                    <div class="text-muted">
                        Hei, <strong>@GetDisplayName(AuthService.CurrentUser?.Email)</strong> :)
                    </div>
                }
            </div>
            <div class="site-actions">
                @if (AuthService.IsSignedIn)
                {
                    <button class="btn btn-outline-secondary small" @onclick="SignOut">Logg ut</button>
                }
            </div>
        </header>

        <article class="site-content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool mobileNavOpen = false;

    private void ToggleMobileNav()
    {
        mobileNavOpen = !mobileNavOpen;
    }

    private void CloseMobileNav()
    {
        mobileNavOpen = false;
    }
}

@code {
    private static string GetDisplayName(string? email)
    {
        return email switch
        {
            "mariets@me.com" => "Marie",
            "fiforsa@gmail.com" => "Fredrik",
            _ => email ?? "Unknown user"
        };
    }

    private async Task SignOut()
    {
        try
        {
            await AuthService.SignOutAsync();
            Navigation.NavigateTo("login");
        }
        catch
        {
            // ignore errors during sign-out
        }
    }
}
