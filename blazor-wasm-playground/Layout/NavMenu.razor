<div class="@NavMenuCssClass nav-scrollable">
    <nav class="site-nav">
        <div class="site-nav-item">
            <NavLink class="site-nav-link" href="" Match="NavLinkMatch.All"
                     @onclick="() => OnLinkClicked.InvokeAsync(null)">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="site-nav-item">
            <NavLink class="site-nav-link" href="counter" @onclick="() => OnLinkClicked.InvokeAsync(null)">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>
        <div class="site-nav-item">
            <NavLink class="site-nav-link" href="weather" @onclick="() => OnLinkClicked.InvokeAsync(null)">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
        <div class="site-nav-item">
            <NavLink class="site-nav-link" href="handleliste" @onclick="() => OnLinkClicked.InvokeAsync(null)">
                <span class="bi bi-card-checklist-nav-menu" aria-hidden="true"></span> Handleliste
            </NavLink>
        </div>
        <div class="site-nav-item">
            <NavLink class="site-nav-link" href="todo" @onclick="() => OnLinkClicked.InvokeAsync(null)">
                <span class="bi bi-card-checklist-nav-menu" aria-hidden="true"></span> Gjøremål
            </NavLink>
        </div>
        <div class="site-nav-item">
            <NavLink class="site-nav-link" href="login" @onclick="() => OnLinkClicked.InvokeAsync(null)">
                <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Login
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public EventCallback OnLinkClicked { get; set; }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
